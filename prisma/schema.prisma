// Zogency — schema v1 (Phase 0: platform layer, doc 03 §5.1)
// Conventions per docs/03-data-model-erd.md §1:
//   uuid v7 ids, tenant_id on all tenant-scoped tables, created_at/created_by,
//   snake_case DB names, scoped unique constraints.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Global (non-tenant) tables ─────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  status    TenantStatus @default(active)
  locale    String   @default("en-IN")
  timezone  String   @default("Asia/Kolkata")
  currency  String   @default("INR") @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  domains     TenantDomain[]
  settings    TenantSettings?
  users       User[]
  roles       Role[]
  departments Department[]
  credentials IntegrationCredential[]

  @@map("tenants")
}

model TenantDomain {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  domain     String    @unique
  isPrimary  Boolean   @default(false) @map("is_primary")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_domains")
}

model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  module      String
  description String @default("")

  rolePermissions RolePermission[]

  @@map("permissions")
}

// ── Tenant-scoped tables ───────────────────────────────────────────────────

model TenantSettings {
  id                   String  @id @default(uuid(7)) @db.Uuid
  tenantId             String  @unique @map("tenant_id") @db.Uuid
  logoFileId           String? @map("logo_file_id") @db.Uuid
  primaryColor         String  @default("#4f46e5") @map("primary_color")
  emailSenderName      String? @map("email_sender_name")
  emailSenderAddress   String? @map("email_sender_address")
  slaHours             Int     @default(24) @map("sla_hours")
  revisionRoundDefault Int     @default(2) @map("revision_round_default")
  featureFlags         Json    @default("{}") @map("feature_flags")
  licenseKey           String? @map("license_key")
  maxDiscountPercent   Int     @default(10) @map("max_discount_percent") // doc 11 Q10 — BRB's matrix values pending
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_settings")
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  name         String
  email        String
  phone        String?
  passwordHash String     @map("password_hash")
  totpSecret   String?    @map("totp_secret")
  status       UserStatus @default(active)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  userRoles UserRole[]

  @@unique([tenantId, email])
  @@map("users")
}

model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Department {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  type       String
  headUserId String?  @map("head_user_id") @db.Uuid
  sort       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("departments")
}

// Append-only (doc 03 §3): no UPDATE/DELETE — enforced in domain layer + DB trigger.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?
  at         DateTime @default(now())

  @@index([tenantId, entityType, entityId, at])
  @@map("audit_logs")
}

// Append-only.
model Notification {
  id          String              @id @default(uuid(7)) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  channel     NotificationChannel
  templateKey String              @map("template_key")
  payload     Json                @default("{}")
  status      NotificationStatus  @default(pending)
  readAt      DateTime?           @map("read_at")
  deliveredAt DateTime?           @map("delivered_at")
  error       String?
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

model File {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  storageKey String   @map("storage_key")
  filename   String
  mime       String
  size       Int
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  versionOf  String?  @map("version_of") @db.Uuid
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, entityType, entityId])
  @@map("files")
}

// Append-only; corrections via supersedes_id (doc 03 §3).
model Comment {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id") @db.Uuid
  authorId     String?  @map("author_id") @db.Uuid
  body         String
  supersedesId String?  @map("supersedes_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, entityType, entityId, createdAt])
  @@map("comments")
}

// Append-only raw webhook intake (doc 02 §6.1).
model WebhookEvent {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  source      String
  externalId  String        @map("external_id")
  raw         Json
  status      WebhookStatus @default(received)
  processedAt DateTime?     @map("processed_at")
  error       String?
  receivedAt  DateTime      @default(now()) @map("received_at")

  @@unique([tenantId, source, externalId])
  @@map("webhook_events")
}

model IntegrationCredential {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  provider        String
  configEncrypted String   @map("config_encrypted")
  status          String   @default("connected")
  connectedBy     String?  @map("connected_by") @db.Uuid
  connectedAt     DateTime @default(now()) @map("connected_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider])
  @@map("integration_credentials")
}

// ── Sales: leads (Sprint 2 — doc 03 §5.2, doc 04 §2–3) ─────────────────────

model LeadSource {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  type        String   // meta|google|website|referral|cold_call|linkedin|event|csv
  name        String
  campaignRef String?  @map("campaign_ref")
  isMql       Boolean  @default(false) @map("is_mql")
  createdAt   DateTime @default(now()) @map("created_at")

  leads Lead[]

  @@unique([tenantId, name])
  @@map("lead_sources")
}

// Tenant-scoped seeded table, NOT a DB enum — Admin-editable per FR-2.6.
model LeadStatus {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  sort       Int      @default(0)
  isTerminal Boolean  @default(false) @map("is_terminal")
  isWon      Boolean  @default(false) @map("is_won")
  isJunk     Boolean  @default(false) @map("is_junk")
  color      String   @default("#64748b")
  createdAt  DateTime @default(now()) @map("created_at")

  leads Lead[]

  @@unique([tenantId, name])
  @@map("lead_statuses")
}

model Lead {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String
  company          String?
  phone            String?   // E.164-normalized
  email            String?   // lowercased
  city             String?   // required for FR-9.1 reporting — captured at intake
  industry         String?
  sourceId         String    @map("source_id") @db.Uuid
  statusId         String    @map("status_id") @db.Uuid
  ownerId          String?   @map("owner_id") @db.Uuid
  slaDueAt         DateTime? @map("sla_due_at")
  firstContactedAt DateTime? @map("first_contacted_at")
  junkReason       String?   @map("junk_reason")
  archivedAt       DateTime? @map("archived_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  source        LeadSource         @relation(fields: [sourceId], references: [id])
  status        LeadStatus         @relation(fields: [statusId], references: [id])
  statusHistory LeadStatusHistory[]
  assignments   LeadAssignment[]
  calls         Call[]
  deal          Deal?

  // Postgres treats NULLs as distinct — rows without phone/email don't collide.
  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@index([tenantId, statusId, ownerId])
  @@index([tenantId, slaDueAt])
  @@map("leads")
}

// Append-only (FR-2.7–2.9): comment is mandatory on every transition.
model LeadStatusHistory {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  fromStatusId String?  @map("from_status_id") @db.Uuid
  toStatusId   String   @map("to_status_id") @db.Uuid
  commentId    String   @map("comment_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  at           DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([tenantId, leadId, at])
  @@map("lead_status_history")
}

// Append-only: latest row = current owner; measures the <1-min NFR.
model LeadAssignment {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  leadId     String   @map("lead_id") @db.Uuid
  assigneeId String   @map("assignee_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid // null = system/rule
  ruleId     String?  @map("rule_id") @db.Uuid
  at         DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([tenantId, leadId, at])
  @@index([tenantId, assigneeId, at])
  @@map("lead_assignments")
}

// BANT qualification (FR-2.10) — gate before a lead leaves Connected (doc 11 Q7).
model BantQualification {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  leadId      String   @unique @map("lead_id") @db.Uuid
  budgetRange String   @map("budget_range")
  authority   String   // decision-maker name/role
  need        String
  timeline    String
  qualifiedBy String?  @map("qualified_by") @db.Uuid
  qualifiedAt DateTime @default(now()) @map("qualified_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("bant_qualifications")
}

model AssignmentRule {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  strategy      String   // round_robin|territory|product_line|account_size
  criteria      Json     @default("{}")
  targetUserIds Json     @default("[]") @map("target_user_ids")
  priority      Int      @default(0)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("assignment_rules")
}

// ── Deals & proposals (Sprint 5 — FR-2.11–2.18, ADR-004) ───────────────────

// Created when BANT qualification completes; carries value/forecast/stage.
model Deal {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  leadId         String    @unique @map("lead_id") @db.Uuid
  ownerId        String?   @map("owner_id") @db.Uuid
  stage          DealStage @default(open)
  value          Decimal?  @db.Decimal(12, 2)
  currency       String    @default("INR") @db.Char(3)
  expectedCloseOn DateTime? @map("expected_close_on") @db.Date
  lostReason     String?   @map("lost_reason")
  wonAt          DateTime? @map("won_at")
  finalTerms     Json?     @map("final_terms")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  lead           Lead            @relation(fields: [leadId], references: [id])
  discoveryNotes DiscoveryNote[]
  proposals      Proposal[]
  contract       Contract?

  @@index([tenantId, stage])
  @@map("deals")
}

// Append-only structured discovery log (FR-2.11, SOP step 6).
model DiscoveryNote {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  dealId             String   @map("deal_id") @db.Uuid
  businessChallenges String   @map("business_challenges")
  requirements       String
  budgetNotes        String?  @map("budget_notes")
  decisionTimeline   String?  @map("decision_timeline")
  authorId           String?  @map("author_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id])

  @@map("discovery_notes")
}

// Reusable per-service-line templates (FR-2.12), Admin-editable.
model ProposalTemplate {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  serviceLine String   @map("service_line")
  name        String
  body        String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([tenantId, name])
  @@map("proposal_templates")
}

model Proposal {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  templateId     String?  @map("template_id") @db.Uuid
  status         String   @default("draft") // draft|sent|accepted
  currentVersion Int      @default(0) @map("current_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  deal     Deal              @relation(fields: [dealId], references: [id])
  versions ProposalVersion[]

  @@map("proposals")
}

// Append-only version trail (FR-2.14/2.15): every revision is a new row.
model ProposalVersion {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  proposalId String    @map("proposal_id") @db.Uuid
  versionNo  Int       @map("version_no")
  listAmount Decimal?  @map("list_amount") @db.Decimal(12, 2)
  amount     Decimal   @db.Decimal(12, 2)
  changeNote String    @map("change_note")
  sentAt     DateTime? @map("sent_at")
  sentBy     String?   @map("sent_by") @db.Uuid
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  proposal Proposal @relation(fields: [proposalId], references: [id])

  @@unique([tenantId, proposalId, versionNo])
  @@map("proposal_versions")
}

// Generic approval workflow (doc 03 §5.2) — reused by discount (FR-2.13),
// marketing brief/budget/creative (FR-3.x), HR requisition/compensation (FR-4.x).
model ApprovalRequest {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  type         String    // discount|budget|brief|creative_internal|requisition|compensation
  entityType   String    @map("entity_type")
  entityId     String    @map("entity_id") @db.Uuid
  summary      String    @default("")
  requestedBy  String    @map("requested_by") @db.Uuid
  approverId   String?   @map("approver_id") @db.Uuid
  state        String    @default("pending") // pending|approved|rejected
  decisionNote String?   @map("decision_note")
  requestedAt  DateTime  @default(now()) @map("requested_at")
  decidedAt    DateTime? @map("decided_at")

  @@index([tenantId, state, type])
  @@index([tenantId, entityType, entityId])
  @@map("approval_requests")
}

// Contract / e-sign record (FR-2.17). Provider 'logged' = written-approval
// fallback until the e-sign vendor is connected (doc 11 Q2).
model Contract {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  dealId         String    @unique @map("deal_id") @db.Uuid
  provider       String    @default("logged") // logged|zoho_sign|docusign
  envelopeId     String?   @map("envelope_id")
  status         String    @default("draft") // draft|sent|signed|declined
  signedAt       DateTime? @map("signed_at")
  evidenceNote   String?   @map("evidence_note")
  documentFileId String?   @map("document_file_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id])

  @@map("contracts")
}

// ── Calls & SLA (Sprint 4 — FR-2.1–2.5) ────────────────────────────────────

// Append-mostly: created at dial/log time, finalized once with outcome;
// immutable thereafter (domain-enforced).
model Call {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  leadId          String        @map("lead_id") @db.Uuid
  userId          String?       @map("user_id") @db.Uuid
  provider        String        @default("manual") // manual|exotel|myoperator|…
  providerCallId  String?       @map("provider_call_id")
  direction       CallDirection @default(outbound)
  startedAt       DateTime      @map("started_at")
  durationSec     Int?          @map("duration_sec")
  disposition     String?       // connected|no_answer|busy|wrong_number|callback_requested
  outcomeNote     String?       @map("outcome_note")
  recordingFileId String?       @map("recording_file_id") @db.Uuid
  isManualLog     Boolean       @default(false) @map("is_manual_log")
  createdAt       DateTime      @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([tenantId, leadId, startedAt])
  @@map("calls")
}

// Append-only breach log (FR-2.5, FR-10.4); resolvedAt is the one pointer field.
model SlaEscalation {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id") @db.Uuid
  ruleRef     String    @map("rule_ref") // e.g. lead_first_contact_sla
  breachedAt  DateTime  @default(now()) @map("breached_at")
  escalatedTo Json      @default("[]") @map("escalated_to") // user ids notified
  resolvedAt  DateTime? @map("resolved_at")

  @@index([tenantId, entityType, entityId])
  @@map("sla_escalations")
}

// ── Automation engine (Sprint 4 — FR-10.1–10.4 core) ───────────────────────

model AutomationRule {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  triggerType String   @map("trigger_type") // record_created|status_changed|sla_breach|date_reached
  entityType  String   @map("entity_type") // lead|task|invoice|…
  conditions  Json     @default("[]") // [{field, op, value}]
  actions     Json     @default("[]") // [{type:'notify', to:'owner'|'role:X', template}]
  enabled     Boolean  @default(true)
  runOrder    Int      @default(0) @map("run_order")
  createdAt   DateTime @default(now()) @map("created_at")

  runs AutomationRun[]

  @@map("automation_rules")
}

// Append-only execution log; eventKey enforces idempotency per rule+event.
model AutomationRun {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  ruleId            String   @map("rule_id") @db.Uuid
  eventKey          String   @map("event_key")
  triggerEntityType String   @map("trigger_entity_type")
  triggerEntityId   String   @map("trigger_entity_id") @db.Uuid
  actionsExecuted   Json     @default("[]") @map("actions_executed")
  status            String   @default("success") // success|partial|failed
  error             String?
  at                DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id])

  @@unique([tenantId, ruleId, eventKey])
  @@map("automation_runs")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum CallDirection {
  inbound
  outbound
}

enum DealStage {
  open
  verbal_commit
  won
  lost
}

enum TenantStatus {
  active
  suspended
}

enum UserStatus {
  active
  disabled
}

enum NotificationChannel {
  in_app
  email
  whatsapp
  sms
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum WebhookStatus {
  received
  processed
  failed
}
