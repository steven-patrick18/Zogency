// ── Marketing campaigns (Phase 2 — FR-3.1–3.20, doc 05) ─────────────────────

// Campaign hub; client work (clientId set) or internal (null). Status gates in
// src/modules/campaigns/service.ts (doc 05 state diagram).
model Campaign {
  id             String         @id @default(uuid(7)) @db.Uuid
