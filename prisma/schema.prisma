// Append-only daily attendance (FR-4.8); corrections via new day rows only.
model AttendanceRecord {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  date       DateTime  @db.Date
  inAt       DateTime? @map("in_at")
  outAt      DateTime? @map("out_at")
  mode       String    @default("office") // office|wfh|leave|holiday
  createdAt  DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([tenantId, employeeId, date])
  @@map("attendance_records")
}

model LeaveType {
  id           String  @id @default(uuid(7)) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  name         String
  code         String? // short code: CL|EL|RH|SL… — rule identity, editable
  annualQuota  Int     @map("annual_quota")
  carryForward Boolean @default(false) @map("carry_forward") // any carry-forward at all
  // ── Strict-policy rules (all admin-configurable, doc HR leave policy 2026) ──
  accrualPerMonth      Int     @default(0) @map("accrual_per_month") // monthly accrual (CL/EL = 1)
  carryForwardMax      Int     @default(0) @map("carry_forward_max") // cap carried to next year (EL = 18)
  maxConsecutive       Int     @default(0) @map("max_consecutive") // per request; 0 = unlimited
  woffAdjacency        String  @default("allowed") @map("woff_adjacency") // allowed|limited1|forbidden
  standaloneOnly       Boolean @default(false) @map("standalone_only") // RH: single, no clubbing
  clubbableWithLeave   Boolean @default(true) @map("clubbable_with_leave") // may share a block with another leave type
  encashable           Boolean @default(false) // may be encashed (EL only, with approval)
  requiresConfirmation Boolean @default(false) @map("requires_confirmation") // accrues only after confirmation (EL)
  lapses               Boolean @default(true) // unused balance lapses at year end
  requiresRestrictedHoliday Boolean @default(false) @map("requires_restricted_holiday") // RH: must land on a published restricted-holiday date

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([tenantId, name])
  @@map("leave_types")
}

model LeaveBalance {
  id            String @id @default(uuid(7)) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  employeeId    String @map("employee_id") @db.Uuid
  typeId        String @map("type_id") @db.Uuid
  year          Int
  available     Int
  used          Int    @default(0)
  accruedMonths Int    @default(0) @map("accrued_months") // monthly accruals granted this year (0–12)
  openingBalance Int   @default(0) @map("opening_balance") // carried forward from last year (accrual types) / full quota (fixed types)

  employee Employee  @relation(fields: [employeeId], references: [id])
  type     LeaveType @relation(fields: [typeId], references: [id])

  @@unique([tenantId, employeeId, typeId, year])
  @@map("leave_balances")
}

// Leave request routed to the reporting manager (FR-4.9).
model LeaveRequest {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  typeId     String    @map("type_id") @db.Uuid
  fromOn     DateTime  @map("from_on") @db.Date
  toOn       DateTime  @map("to_on") @db.Date
  days       Int
  reason     String
  state      String    @default("pending") // pending|approved|rejected
  decidedBy  String?   @map("decided_by") @db.Uuid
  decidedAt  DateTime? @map("decided_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  employee Employee  @relation(fields: [employeeId], references: [id])
  type     LeaveType @relation(fields: [typeId], references: [id])

  @@map("leave_requests")
}

model Holiday {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  date     DateTime @db.Date
  name     String
  kind     String   @default("public") // public = mandatory day off | restricted = optional, employee picks via RH leave

  @@unique([tenantId, date])
  @@map("holidays")
}

model PerformanceCycle {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  status      String   @default("open") // open|closed

  goals   EmployeeGoal[]
  reviews PerformanceReview[]

  @@unique([tenantId, name])
  @@map("performance_cycles")
}

// Goal/KPI per employee per cycle (FR-4.12).
model EmployeeGoal {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  cycleId    String @map("cycle_id") @db.Uuid
  title      String
  kpi        String
  target     String
  weight     Int    @default(25)

  employee Employee         @relation(fields: [employeeId], references: [id])
  cycle    PerformanceCycle @relation(fields: [cycleId], references: [id])

  @@map("employee_goals")
}

// Append-only review record (FR-4.13): self → manager → final rating.
model PerformanceReview {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  cycleId        String   @map("cycle_id") @db.Uuid
  selfAssessment String?  @map("self_assessment")
  managerReview  String?  @map("manager_review")
  finalRating    Int?     @map("final_rating") // 1–5
  reviewedBy     String?  @map("reviewed_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  employee Employee         @relation(fields: [employeeId], references: [id])
  cycle    PerformanceCycle @relation(fields: [cycleId], references: [id])

  @@unique([tenantId, employeeId, cycleId])
  @@map("performance_reviews")
}

// ── Vendor console (master server only, ZOGENCY_VENDOR_MODE=1) ──────────────

// A provisioned client install. SSH credentials are AES-encrypted and CLEARED
// automatically after a successful install.
model VendorClient {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  companyName      String    @map("company_name")
  contactEmail     String    @map("contact_email")
  domain           String
  serverIp         String    @map("server_ip")
  sshUser          String    @default("root") @map("ssh_user")
  sshPasswordEnc   String?   @map("ssh_password_enc") // encrypted; null after success
  licenseKey       String    @map("license_key")
  licenseExpiresAt DateTime  @map("license_expires_at")
  plan             String    @default("pro")
  seats            Int       @default(15)
  status           String    @default("pending") // pending|installing|installed|failed
  installLog       String    @default("") @map("install_log")
  setupLink        String?   @map("setup_link")
  installedAt      DateTime? @map("installed_at")
  lastSeenVersion  String?   @map("last_seen_version") // git sha reported by the client updater
  lastCheckinAt    DateTime? @map("last_checkin_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("vendor_clients")
}

// Published update releases — client servers poll /api/vendor/release and
// self-update to the latest published ref ("update from my panel").
model VendorRelease {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  ref         String   @default("main") // git branch or pinned commit sha
  notes       String   @default("")
  publishedBy String?  @map("published_by") @db.Uuid
  publishedAt DateTime @default(now()) @map("published_at")

  @@map("vendor_releases")
}

// ── Retention & renewal (Phase 2 — FR-7.1–7.6, doc 07 §5) ───────────────────

model Renewal {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  contractRef String?  @map("contract_ref")
  renewalOn   DateTime @map("renewal_on") @db.Date
  value       Decimal  @db.Decimal(12, 2)
  status      String   @default("upcoming") // upcoming|in_progress|renewed|lost
  // Which of the 60/30/15-day triggers have fired (FR-7.2).
  triggersFired Json   @default("[]") @map("triggers_fired")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId, renewalOn, status])
  @@map("renewals")
}

// Append-only relationship check-ins (FR-7.1, SOP step 19).
model ClientCheckin {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  scheduledAt DateTime  @map("scheduled_at")
  heldAt      DateTime? @map("held_at")
  notes       String?
  ownerId     String?   @map("owner_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("client_checkins")
}

// Append-only weekly computation (FR-7.3, formula per doc 11 Q9).
model ClientHealthScore {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  score      Int      // 0–100
  band       String   // green|amber|red
  components Json     // { payments, approvals, survey }
  computedAt DateTime @default(now()) @map("computed_at")

  @@index([tenantId, clientId, computedAt])
  @@map("client_health_scores")
}

// Append-only churn escalation (FR-7.4).
model ChurnFlag {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  clientId    String    @map("client_id") @db.Uuid
  reason      String
  severity    String    @default("high") // high|watch
  escalatedTo Json      @default("[]") @map("escalated_to")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // A partial unique index (one unresolved flag per client) is created in
  // migration 20260724220000_audit_hardening_uniques — it cannot be expressed
  // in the Prisma schema DSL (no WHERE on @@unique). Keep them in sync manually.
  @@map("churn_flags")
}

// Service catalogue (FR-7.5) — feeds upsells (and SoW/service lines).
model ServiceCatalogItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  name        String
  description String  @default("")
  priceBand   String? @map("price_band")
  active      Boolean @default(true)

  upsells UpsellOpportunity[]

  @@unique([tenantId, name])
  @@map("service_catalog")
}

model UpsellOpportunity {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  stage     String   @default("idea") // idea|proposed|won|lost
  value     Decimal? @db.Decimal(12, 2)
  ownerId   String?  @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  service ServiceCatalogItem @relation(fields: [serviceId], references: [id])

  @@map("upsell_opportunities")
}

// ── Payroll (Phase 3) — attendance-linked payout sheets + payslips ──────────

model PayrollRun {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  periodmonth Int       @map("period_month") // 1–12
  periodyear  Int       @map("period_year")
  status      String    @default("draft") // draft|finalized
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  finalizedAt DateTime? @map("finalized_at")

  payslips Payslip[]

  @@unique([tenantId, periodmonth, periodyear])
  @@map("payroll_runs")
}

model Payslip {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  runId       String  @map("run_id") @db.Uuid
  employeeId  String  @map("employee_id") @db.Uuid
  basic       Decimal @db.Decimal(12, 2)
  allowances  Decimal @default(0) @db.Decimal(12, 2)
  deductions  Decimal @default(0) @db.Decimal(12, 2)
  lopDays     Int     @default(0) @map("lop_days") // loss-of-pay days from attendance/leave
  netPay      Decimal @map("net_pay") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  run      PayrollRun @relation(fields: [runId], references: [id])

  @@unique([tenantId, runId, employeeId])
  @@map("payslips")
}

// Employee salary structure (used by payroll).
model SalaryStructure {
  id         String  @id @default(uuid(7)) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  employeeId String  @unique @map("employee_id") @db.Uuid
  basic      Decimal @db.Decimal(12, 2)
  allowances Decimal @default(0) @db.Decimal(12, 2)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("salary_structures")
}

// ── Meetings module (Phase 3) — recording upload + AI summary ───────────────

model Meeting {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  clientId       String?   @map("client_id") @db.Uuid
  title          String
  meetingAt      DateTime  @map("meeting_at")
  recordingUrl   String?   @map("recording_url")
  transcript     String?
  aiSummary      String?   @map("ai_summary")
  summaryStatus  String    @default("none") @map("summary_status") // none|pending|done|failed
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([tenantId, meetingAt])
  @@map("meetings")
}

// ── Phase 2 comms: portal, tickets, chat, content, campaigns ────────────────

// Support tickets (client portal ↔ staff).
model SupportTicket {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  clientId   String    @map("client_id") @db.Uuid
  contactId  String?   @map("contact_id") @db.Uuid // portal contact who raised it
  subject    String
  status     String    @default("open") // open|in_progress|resolved|closed
  priority   String    @default("normal") // low|normal|high
  assigneeId String?   @map("assignee_id") @db.Uuid // staff user
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  messages TicketMessage[]

  @@index([tenantId, status])
  @@map("support_tickets")
}

// Append-only ticket thread; authorKind distinguishes client vs staff.
model TicketMessage {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorKind String   @map("author_kind") // client|staff
  authorId   String?  @map("author_id") @db.Uuid
  authorName String   @map("author_name")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([tenantId, ticketId, createdAt])
  @@map("ticket_messages")
}

// Internal team chat with @mentions (append-only).
model ChatMessage {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  channel    String   @default("general") // simple named channels
  authorId   String   @map("author_id") @db.Uuid
  body       String
  mentions   Json     @default("[]") // user ids @-mentioned
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, channel, createdAt])
  @@map("chat_messages")
}

// Content calendar item (per client/campaign).
model ContentItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  clientId    String?   @map("client_id") @db.Uuid
  campaignId  String?   @map("campaign_id") @db.Uuid
  title       String
  channel     String    @default("instagram") // instagram|facebook|blog|email|youtube|other
  scheduledOn DateTime  @map("scheduled_on") @db.Date
  status      String    @default("idea") // idea|drafting|review|scheduled|published
  ownerId     String?   @map("owner_id") @db.Uuid
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, scheduledOn])
  @@map("content_items")
}

// Email campaign (builder + queued send; live send gated on email integration).
model EmailCampaign {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  subject     String
  body        String
  status      String   @default("draft") // draft|scheduled|sending|sent
  scheduledAt DateTime? @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  recipients EmailCampaignRecipient[]

  @@map("email_campaigns")
}

model EmailCampaignRecipient {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  campaignId String    @map("campaign_id") @db.Uuid
  email      String
  name       String?
  status     String    @default("pending") // pending|sent|failed
  sentAt     DateTime? @map("sent_at")

  campaign EmailCampaign @relation(fields: [campaignId], references: [id])

  @@map("email_campaign_recipients")
}

// Scheduled report delivery (email/WhatsApp; queued, send gated on integration).
model ScheduledDelivery {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  reportKey   String    @map("report_key") // which dashboard/report
  clientId    String?   @map("client_id") @db.Uuid
  channel     String    @default("email") // email|whatsapp
  recipient   String
  cadence     String    @default("weekly") // daily|weekly|monthly
  nextRunOn   DateTime  @map("next_run_on") @db.Date
  lastSentAt  DateTime? @map("last_sent_at")
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([tenantId, nextRunOn, enabled])
  @@map("scheduled_deliveries")
}

// Retainer billing schedule — auto-generates invoices monthly (FR-8/retainer).
model RetainerSchedule {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  clientId     String    @map("client_id") @db.Uuid
  projectId    String?   @map("project_id") @db.Uuid
  description  String
  amount       Decimal   @db.Decimal(12, 2)
  billingDay   Int       @default(1) @map("billing_day") // day of month
  nextInvoiceOn DateTime @map("next_invoice_on") @db.Date
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([tenantId, nextInvoiceOn, active])
  @@map("retainer_schedules")
}

// ── Desktop activity monitoring (Electron agent ingest) ─────────────────────
// Requires signed employee consent (doc 11 risk note) — surfaced in the UI.
model ActivityPing {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  at          DateTime @default(now())
  appName     String?  @map("app_name")
  windowTitle String?  @map("window_title") // active window title (deep monitoring — DLP signal)
  idleSec     Int      @default(0) @map("idle_sec")

  @@index([tenantId, userId, at])
  @@map("activity_pings")
}

// Periodic screen captures from the desktop agent (deep monitoring, consented).
// Downscaled JPEG data-URIs; pruned after RETENTION days by the ingest route.
model ScreenCapture {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  at       DateTime @default(now())
  appName  String?  @map("app_name") // foreground app at capture time
  image    String // data:image/jpeg;base64,… (≤ ~300KB, downscaled)

  @@index([tenantId, userId, at])
  @@map("screen_captures")
}

// ── Calls & SLA (Sprint 4 — FR-2.1–2.5) ────────────────────────────────────

// Append-mostly: created at dial/log time, finalized once with outcome;
// immutable thereafter (domain-enforced).
model Call {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  leadId          String        @map("lead_id") @db.Uuid
  userId          String?       @map("user_id") @db.Uuid
  provider        String        @default("manual") // manual|exotel|myoperator|…
  providerCallId  String?       @map("provider_call_id")
  direction       CallDirection @default(outbound)
  startedAt       DateTime      @map("started_at")
  durationSec     Int?          @map("duration_sec")
  disposition     String?       // connected|no_answer|busy|wrong_number|callback_requested
  outcomeNote     String?       @map("outcome_note")
  recordingFileId String?       @map("recording_file_id") @db.Uuid
  recordingUrl    String?       @map("recording_url") // provider recording URL (FR-2.3)
  isManualLog     Boolean       @default(false) @map("is_manual_log")
  createdAt       DateTime      @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([tenantId, leadId, startedAt])
  @@map("calls")
}

// Append-only breach log (FR-2.5, FR-10.4); resolvedAt is the one pointer field.
model SlaEscalation {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id") @db.Uuid
  ruleRef     String    @map("rule_ref") // e.g. lead_first_contact_sla
  breachedAt  DateTime  @default(now()) @map("breached_at")
  escalatedTo Json      @default("[]") @map("escalated_to") // user ids notified
  resolvedAt  DateTime? @map("resolved_at")

  @@unique([tenantId, entityType, entityId, ruleRef])
  @@index([tenantId, entityType, entityId])
  @@map("sla_escalations")
}

// ── Automation engine (Sprint 4 — FR-10.1–10.4 core) ───────────────────────

model AutomationRule {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  triggerType String   @map("trigger_type") // record_created|status_changed|sla_breach|date_reached
  entityType  String   @map("entity_type") // lead|task|invoice|…
  conditions  Json     @default("[]") // [{field, op, value}]
  actions     Json     @default("[]") // [{type:'notify', to:'owner'|'role:X', template}]
  enabled     Boolean  @default(true)
  runOrder    Int      @default(0) @map("run_order")
  createdAt   DateTime @default(now()) @map("created_at")

  runs AutomationRun[]

  @@map("automation_rules")
}

// Append-only execution log; eventKey enforces idempotency per rule+event.
model AutomationRun {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  ruleId            String   @map("rule_id") @db.Uuid
  eventKey          String   @map("event_key")
  triggerEntityType String   @map("trigger_entity_type")
  triggerEntityId   String   @map("trigger_entity_id") @db.Uuid
  actionsExecuted   Json     @default("[]") @map("actions_executed")
  status            String   @default("success") // success|partial|failed
  error             String?
  at                DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id])

  @@unique([tenantId, ruleId, eventKey])
  @@map("automation_runs")
}

